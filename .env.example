# ─────────────────────────────────────────────
#  Application
# ─────────────────────────────────────────────
APP_NAME="Unilever Cloud Operations Portal"
APP_ENV=development
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key-min-32-chars

# ─────────────────────────────────────────────
#  Database  (PostgreSQL at 10.234.5.165)
#  NOTE: URL-encode special chars in password, e.g. @ → %40
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://testappuser:YOUR_PASSWORD_URL_ENCODED@10.234.5.165:5432/testappdb?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://testappuser:YOUR_PASSWORD_URL_ENCODED@10.234.5.165:5432/testappdb?sslmode=require

# ─────────────────────────────────────────────
#  JWT
# ─────────────────────────────────────────────
JWT_SECRET_KEY=change-me-generate-a-different-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─────────────────────────────────────────────
#  Micetro Service Account
# ─────────────────────────────────────────────
MICETRO_BASE_URL=https://ssportal-qa.unilever.com/mmws/api/v2
MICETRO_USERNAME=service_account_username
MICETRO_PASSWORD=service_account_password
MICETRO_VERIFY_SSL=true
MICETRO_SESSION_TIMEOUT=3600

# ─────────────────────────────────────────────
#  Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=2
RATE_LIMIT_PERIOD_HOURS=24

# ─────────────────────────────────────────────
#  Bootstrap admin (used on first startup only)
# ─────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@unilever.com
INITIAL_ADMIN_PASSWORD=change-me-on-first-login
INITIAL_ADMIN_FULL_NAME="Portal Administrator"
